{
  "name": "luxor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Luxor: the guest booking engine and the hotelier console, white-labelled per property.",
  "scripts": {
    "sync-sdk": "mkdir -p public && cp node_modules/@thebes/sdk/runtime/memphis-connect.js node_modules/@thebes/sdk/runtime/noble-ed25519-3.1.0.js public/",
    "dev": "npm run sync-sdk && vite --host 127.0.0.1 --port 5174",
    "build": "npm run sync-sdk && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.2.5",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/mulish": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.5",
    "@fontsource/marcellus": "^5.2.5",
    "@fontsource/reem-kufi": "^5.2.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@thebes/sdk": "github:Mercatura-Forum/thebes-sdk#0ff37eba76648cc835580df0c5264717d088fb51",
    "lucide-react": "^0.544.0",
    "preact": "^10.29.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lighthouse": "^12.8.2",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^4.1.0",
    "terser": "^5.51.2",
    "typescript": "~5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
